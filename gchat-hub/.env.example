# URL production integration-gateway, tanpa path
GATEWAY_URL=https://NAMA-GATEWAY.vercel.app
# Nilai acak yang SAMA pada kedua aplikasi (minimal 32 karakter)
BRIDGE_SECRET=
# Connection string Neon yang sudah dipakai sebelumnya
DATABASE_URL=
# Isi lengkap satu JSON service account pengirim bot
GOOGLE_SERVICE_ACCOUNT_JSON=
# Password login halaman admin, minimal 12 karakter; username: admin
ADMIN_PASSWORD=

# Development: payload dan alur di terminal / Vercel Logs; credential disamarkan
DEBUG_FLOW=false

# Opsional: aktifkan API aplikasi lain. Satu client/secret berbeda per program.
APP_CLIENTS_JSON=[]
