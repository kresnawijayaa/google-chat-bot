{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/profile-picture-bot.jpeg",
      "dest": "/public/profile-picture-bot.jpeg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
