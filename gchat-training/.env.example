# Origin HTTPS endpoint latihan, tanpa /google-chat
PUBLIC_BASE_URL=
# Satu JSON lengkap service account pengirim bot
GOOGLE_SERVICE_ACCOUNT_JSON=
# Identitas add-on dari Google Chat API Configuration
GOOGLE_ADDON_SERVICE_ACCOUNT_EMAIL=
# Login halaman demo: username admin, password minimal 12 karakter
ADMIN_PASSWORD=

# Wajib di Vercel; boleh pakai connection string Neon hub yang sama
DATABASE_URL=
