# URL production gchat-hub, tanpa path
HUB_URL=https://NAMA-HUB.vercel.app
# URL production gateway ini sendiri, tanpa path
PUBLIC_URL=https://NAMA-GATEWAY.vercel.app
# Salin nilai BRIDGE_SECRET dari hub
BRIDGE_SECRET=
# Email service account add-on di Google Chat API Configuration
GOOGLE_ADDON_SERVICE_ACCOUNT_EMAIL=

# Development: payload dan alur di terminal / Vercel Logs; credential disamarkan
DEBUG_FLOW=false
